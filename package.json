{
  "name": "trove",
  "version": "0.1.0",
  "description": "Offline semantic search for your local files",
  "main": "./out/main/index.js",
  "author": "Dinson Davis",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm run build:worker && electron-vite dev",
    "build": "electron-vite build && npm run build:worker",
    "build:worker": "vite build -c vite.worker.config.ts",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "corpus": "node scripts/make-corpus.mjs",
    "bench": "electron scripts/bench",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@huggingface/transformers": "^4.2.0",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "mammoth": "^1.12.1",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
